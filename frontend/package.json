{
  "name": "connect4-web-ui",
  "private": true,
  "version": "3.3.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.2",
    "connect-four-ai-wasm": "1.0.0",
    "pinia": "^3.0.3",
    "qrcode-generator": "^2.0.4",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.14",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "typescript": "~5.8.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.13"
  }
}
